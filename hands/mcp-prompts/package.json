{
  "name": "mcp-prompts",
  "version": "1.0.0",
  "description": "A unified MCP server for custom prompts across Claude Code, Cursor, and Codex CLI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-prompts": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/index.ts",
    "dev:web": "tsx src/index.ts web",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write src test",
    "test": "vitest",
    "test:run": "vitest run",
    "release": "npm pack"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "prompts",
    "claude",
    "cursor",
    "codex",
    "cli"
  ],
  "author": "Author",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chokidar": "^3.5.3",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

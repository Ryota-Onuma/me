{
  "name": "background-image",
  "displayName": "Background Image (Unsafe Mode Only)",
  "description": "Unsafe workbench background images by directly modifying VS Code/Cursor CSS. LOCAL USE ONLY - DO NOT PUBLISH",
  "version": "1.1.2",
  "private": true,
  "publisher": "ryota-onuma",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryota-Onuma/me"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "backgroundImage.unsafe.setImage",
        "title": "Set Unsafe Background Image",
        "category": "Background Image (Unsafe)"
      },
      {
        "command": "backgroundImage.unsafe.apply",
        "title": "Apply Unsafe Background",
        "category": "Background Image (Unsafe)"
      },
      {
        "command": "backgroundImage.unsafe.remove",
        "title": "Remove Unsafe Background",
        "category": "Background Image (Unsafe)"
      },
      {
        "command": "backgroundImage.unsafe.openCssPath",
        "title": "Open Workbench CSS Path",
        "category": "Background Image (Unsafe)"
      }
    ],
    "configuration": {
      "title": "Background Image",
      "properties": {
        "backgroundImage.unsafe.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable unsafe mode (modifies workbench files directly)"
        },
        "backgroundImage.unsafe.image": {
          "type": "string",
          "description": "Background image path for unsafe mode (file:// or data: URI)"
        },
        "backgroundImage.unsafe.opacity": {
          "type": "number",
          "default": 0.12,
          "minimum": 0,
          "maximum": 1,
          "description": "Background opacity for unsafe mode (0-1)"
        },
        "backgroundImage.unsafe.size": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "auto"
          ],
          "default": "cover",
          "description": "Background size for unsafe mode"
        },
        "backgroundImage.unsafe.position": {
          "type": "string",
          "default": "center",
          "description": "Background position for unsafe mode"
        },
        "backgroundImage.unsafe.repeat": {
          "type": "string",
          "default": "no-repeat",
          "description": "Background repeat for unsafe mode"
        },
        "backgroundImage.unsafe.workbenchCssPath": {
          "type": "string",
          "description": "Manual override for workbench CSS path (for detection failures)"
        },
        "backgroundImage.unsafe.embedImage": {
          "type": "boolean",
          "default": true,
          "description": "Embed image as data: URL instead of file: path"
        },
        "backgroundImage.unsafe.suppressBannerAfterRemove": {
          "type": "boolean",
          "default": true,
          "description": "After Remove, keep a tiny JS-only patch to hide the 'installation appears to be corrupt' banner."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/publish-guard.js && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "node scripts/publish-guard.js && vsce package",
    "publish": "echo '❌ PUBLISH BLOCKED: This extension is for local use only. DO NOT PUBLISH!' && exit 1",
    "vscode:publish": "echo '❌ VSCODE PUBLISH BLOCKED: This extension is for local use only. DO NOT PUBLISH!' && exit 1",
    "guard:check": "node scripts/publish-guard.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "1.70.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vscode/test-electron": "^2.3.8",
    "eslint": "^8.57.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5",
    "vsce": "^2.15.0"
  }
}

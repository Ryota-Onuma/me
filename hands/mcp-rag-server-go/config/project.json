{
  "project": "mcp-rag-server-go",
  "postgres": {
    "host": "localhost",
    "port": 5432,
    "user": "postgres",
    "password": "password",
    "db": "rag_db",
    "schema": "mcp_rag_go"
  },
  "embedding": {
    "model": "intfloat/multilingual-e5-large",
    "dim": 1024,
    "prefix_query": "query: ",
    "prefix_embedding": "passage: ",
    "api_endpoint": "http://localhost:8080/embeddings"
  },
  "paths": {
    "source_dir": "data/source",
    "processed_dir": "data/processed"
  },
  "security": {
    "max_query_length": 2000,
    "max_result_limit": 50,
    "max_file_size": 104857600
  },
  "logging": {
    "enable_file_logging": false,
    "level": "INFO"
  },
  "server": {
    "name": "mcp-rag-server-go",
    "version": "1.0.0",
    "description": "MCP RAG Server - Go implementation"
  }
}
# プロジェクト設定
PROJECT=mcp-rag-server-go

# PostgreSQL設定（Dockerで起動）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=rag_db
POSTGRES_SCHEMA=mcp_rag_go

# 埋め込みモデル設定
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_PREFIX_QUERY=query:
EMBEDDING_PREFIX_EMBEDDING=passage:
# 外部埋め込みAPIを使用する場合はコメントアウト
# EMBEDDING_API_ENDPOINT=http://localhost:8080/embeddings

# パス設定（ローカル実行用）
SOURCE_DIR=data/source
PROCESSED_DIR=data/processed

# ログ設定
ENABLE_FILE_LOGGING=false
LOG_LEVEL=INFO

# セキュリティ設定
MAX_QUERY_LENGTH=2000
MAX_RESULT_LIMIT=50
MAX_FILE_SIZE=104857600
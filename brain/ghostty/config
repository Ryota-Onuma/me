# -----------------------------------------------------------------------------
# Ghostty 設定ファイル
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 0. キーバインド設定 (Neovim への Cmd+key 転送)
# -----------------------------------------------------------------------------

# Cmd+key を kitty keyboard protocol の CSI u シーケンスとして Neovim に送信
# 書式: \x1b[<ASCIIコード>;<修飾子>u  (修飾子 9 = Super/Cmd)
keybind = super+p=text:\x1b[112;9u
keybind = super+shift+p=text:\x1b[80;9u
keybind = super+f=text:\x1b[102;9u
keybind = super+shift+f=text:\x1b[70;9u
keybind = super+shift+o=text:\x1b[79;9u
keybind = super+s=text:\x1b[115;9u
keybind = super+w=text:\x1b[119;9u
keybind = super+z=text:\x1b[122;9u
keybind = super+shift+z=text:\x1b[90;9u
keybind = super+a=text:\x1b[97;9u
keybind = super+shift+k=text:\x1b[75;9u
keybind = super+slash=text:\x1b[47;9u
keybind = super+b=text:\x1b[98;9u
keybind = super+j=text:\x1b[106;9u
keybind = super+period=text:\x1b[46;9u

# -----------------------------------------------------------------------------
# 1. フォント設定
# -----------------------------------------------------------------------------
font-family = CaskaydiaCove NF Regular
font-size = 14.0

# -----------------------------------------------------------------------------
# 2. ウィンドウ設定（パディング/余白）
# -----------------------------------------------------------------------------
window-padding-x = 30
window-padding-y = 20

# -----------------------------------------------------------------------------
# 3. カーソル設定
# -----------------------------------------------------------------------------
cursor-style = block

# -----------------------------------------------------------------------------
# 4. 背景画像
# -----------------------------------------------------------------------------
background-image = 'path/to/your/image.jpg'

background-image-fit = cover

# -----------------------------------------------------------------------------
# 5. 基本カラー設定
# -----------------------------------------------------------------------------

# 背景色: 黒
background = #000000

# 文字色: 明るい緑
foreground = #00FF66

# 選択範囲の背景: 青
selection-background = #2233FF

# 選択範囲の文字: 白
selection-foreground = #FFFFFF

# -----------------------------------------------------------------------------
# 6. ANSIカラーパレット (通常色: 0-7)
# -----------------------------------------------------------------------------

# 0: 黒 (Black)
palette = 0=#000000

# 1: 白 (White)
palette = 1=#FFFFFF

# 2: 緑 (Green)
palette = 2=#66CC00

# 3: 黄色 (Yellow)
palette = 3=#CCCC00

# 4: 白 (White)
palette = 4=#FFFFFF

# 5: 黄色 (Yellow)
palette = 5=#CCCC00

# 6: シアン (Cyan)
palette = 6=#33CCCC

# 7: 明るいグレー (Light Gray)
palette = 7=#E5E5E5

# -----------------------------------------------------------------------------
# 7. ANSIカラーパレット (明るい色: 8-15)
# -----------------------------------------------------------------------------

# 8: 暗いグレー (Dark Gray)
palette = 8=#333333

# 9: 明るい赤 (Bright Red)
palette = 9=#FF3333

# 10: 明るい緑 (Bright Green)
palette = 10=#99FF33

# 11: 明るい黄色 (Bright Yellow)
palette = 11=#FFFF66

# 12: 白 (White)
palette = 12=#FFFFFF

# 13: 明るいマゼンタ/ピンク (Bright Magenta)
palette = 13=#FF66FF

# 14: 明るいシアン (Bright Cyan)
palette = 14=#66FFFF

# 15: 白 (White)
palette = 15=#FFFFFF
